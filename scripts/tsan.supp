# System libraries that TSan cannot see into (uninstrumented): their internal
# locking reads as races or lock inversions. Engine code is never listed here.
deadlock:libdbus-1.so
race:libdbus-1.so
race:libglib-2.0.so
race:libgio-2.0.so
race:libgallium-*.so
race:libdrm_amdgpu.so
called_from_lib:libdbus-1.so
called_from_lib:libglib-2.0.so
called_from_lib:libgio-2.0.so
called_from_lib:libgallium-*.so
called_from_lib:libdrm_amdgpu.so
deadlock:libxcb.so
deadlock:libX11.so
race:libxcb.so
race:libX11.so
called_from_lib:libxcb.so
called_from_lib:libX11.so
