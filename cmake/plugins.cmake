# Project plugins (M5.2, cartwheel/plugin.h): cw_add_app compiles the
# enabled RUNTIME plugins of <app source dir>/plugins/<name>/ into the app
# and generates its plugin table; natively it also builds every plugin as
# shared libraries the native editor loads:
#   <build>/plugins/<name>/<name>_runtime.so   runtime part (node types ...)
#   <build>/plugins/<name>/<name>_editor.so    editor part (CWED_PLUGIN module)
# (target cwplugins_all builds them; tools/cwproject.mjs build <dir> plugins).
# A plugin whose manifest asks for another engine API, misses a dependency
# or is disabled is NOT compiled: the table records why, and the game's
# errors about its node types name it (cw_plugin_type_hint).

file(STRINGS ${CMAKE_SOURCE_DIR}/include/cartwheel/plugin.h _cw_api_major REGEX "^#define CW_ENGINE_API_MAJOR ")
file(STRINGS ${CMAKE_SOURCE_DIR}/include/cartwheel/plugin.h _cw_api_minor REGEX "^#define CW_ENGINE_API_MINOR ")
string(REGEX REPLACE ".* ([0-9]+)$" "\\1" CW_ENGINE_API_MAJOR "${_cw_api_major}")
string(REGEX REPLACE ".* ([0-9]+)$" "\\1" CW_ENGINE_API_MINOR "${_cw_api_minor}")
if(NOT TARGET cwplugins_all)
  add_custom_target(cwplugins_all)
endif()

# cw__manifest_get(<file> <key> <out>): a key's value (quotes trimmed), "" when absent
function(cw__manifest_get file key out)
  file(STRINGS ${file} _l REGEX "^[ \t]*${key}[ \t]*=")
  set(_v "")
  if(_l)
    list(GET _l 0 _l)
    string(REGEX REPLACE "^[ \t]*${key}[ \t]*=[ \t]*" "" _v "${_l}")
    string(STRIP "${_v}" _v)
    string(REGEX REPLACE "^\"(.*)\"$" "\\1" _v "${_v}")
  endif()
  set(${out} "${_v}" PARENT_SCOPE)
endfunction()

# the .c files of a plugin's source list (comma separated, plugin-relative)
function(cw__plugin_sources pdir list out)
  set(_srcs "")
  string(REPLACE "," ";" list "${list}")
  foreach(s ${list})
    string(STRIP "${s}" s)
    if(IS_DIRECTORY ${pdir}/${s})
      file(GLOB_RECURSE _f CONFIGURE_DEPENDS ${pdir}/${s}/*.c)
      list(APPEND _srcs ${_f})
    elseif(EXISTS ${pdir}/${s})
      list(APPEND _srcs ${pdir}/${s})
    endif()
  endforeach()
  list(SORT _srcs)
  set(${out} "${_srcs}" PARENT_SCOPE)
endfunction()

# cw__app_plugins(<app> <plugins dir>): compile + table for one app
function(cw__app_plugins app pdir_root quiet want_editor)
  file(GLOB _manifests CONFIGURE_DEPENDS ${pdir_root}/*/plugin.cwplugin)
  get_filename_component(_root_name ${pdir_root} NAME)
  list(SORT _manifests)
  set(_names "")
  foreach(m ${_manifests})
    get_filename_component(_d ${m} DIRECTORY)
    get_filename_component(_n ${_d} NAME)
    list(APPEND _names ${_n})
    set(_dir_${_n} ${_d})
  endforeach()
  # pass 1: manifest checks (name, kind, API version, enabled)
  foreach(n ${_names})
    set(f ${_dir_${n}}/plugin.cwplugin)
    foreach(k name version engine_api kind provides depends enabled runtime_sources editor_sources)
      cw__manifest_get(${f} ${k} _m_${n}_${k})
    endforeach()
    if(_m_${n}_runtime_sources STREQUAL "")
      set(_m_${n}_runtime_sources runtime)
    endif()
    if(_m_${n}_editor_sources STREQUAL "")
      set(_m_${n}_editor_sources editor)
    endif()
    set(_st_${n} LOADED)
    set(_err_${n} "")
    set(_rt_${n} OFF)
    set(_ed_${n} OFF)
    set(_kind "${_m_${n}_kind}")
    if(_kind STREQUAL "")
      set(_kind runtime)
    endif()
    if(_kind STREQUAL "runtime" OR _kind STREQUAL "both" OR _kind MATCHES "^runtime, *editor$")
      set(_rt_${n} ON)
    endif()
    if(_kind STREQUAL "editor" OR _kind STREQUAL "both" OR _kind MATCHES "^runtime, *editor$")
      set(_ed_${n} ON)
    endif()
    set(_api "${_m_${n}_engine_api}")
    if(NOT _m_${n}_name STREQUAL n)
      set(_st_${n} FAILED)
      set(_err_${n} "plugin.cwplugin: name = ${_m_${n}_name} must equal its directory name (${n})")
    elseif(NOT _rt_${n} AND NOT _ed_${n})
      set(_st_${n} FAILED)
      set(_err_${n} "plugin.cwplugin: kind = ${_m_${n}_kind} (runtime, editor or both)")
    elseif(NOT _api MATCHES "^([0-9]+)(\\.([0-9]+))?$")
      set(_st_${n} FAILED)
      set(_err_${n} "plugin.cwplugin: engine_api = '${_api}' (MAJOR.MINOR, e.g. ${CW_ENGINE_API_MAJOR}.${CW_ENGINE_API_MINOR})")
    else()
      set(_maj ${CMAKE_MATCH_1})
      set(_min 0)
      if(CMAKE_MATCH_3)
        set(_min ${CMAKE_MATCH_3})
      endif()
      if(NOT _maj EQUAL CW_ENGINE_API_MAJOR)
        set(_st_${n} REFUSED)
        set(_err_${n} "plugin '${n}' refused: it needs engine API ${_maj}.${_min} (engine_api in ${_root_name}/${n}/plugin.cwplugin) and this engine provides ${CW_ENGINE_API_MAJOR}.${CW_ENGINE_API_MINOR}; a different major version is incompatible (port the plugin to API ${CW_ENGINE_API_MAJOR}.x)")
      elseif(_min GREATER CW_ENGINE_API_MINOR)
        set(_st_${n} REFUSED)
        set(_err_${n} "plugin '${n}' refused: it needs engine API ${_maj}.${_min} (engine_api in ${_root_name}/${n}/plugin.cwplugin) and this engine provides only ${CW_ENGINE_API_MAJOR}.${CW_ENGINE_API_MINOR} (update the engine)")
      endif()
    endif()
    if(_st_${n} STREQUAL LOADED AND _m_${n}_enabled MATCHES "^(false|0|off|no)$")
      set(_st_${n} DISABLED)
      set(_err_${n} "enabled = false in ${_root_name}/${n}/plugin.cwplugin")
    endif()
  endforeach()
  # pass 2: dependencies (a plugin whose dependency is missing or not loaded is refused), to a fixed point
  set(_changed ON)
  while(_changed)
    set(_changed OFF)
    foreach(n ${_names})
      if(_st_${n} STREQUAL LOADED)
        string(REPLACE "," ";" _deps "${_m_${n}_depends}")
        foreach(dep ${_deps})
          string(STRIP "${dep}" dep)
          if(dep STREQUAL "")
            continue()
          endif()
          if(NOT DEFINED _st_${dep})
            set(_st_${n} REFUSED)
            set(_err_${n} "plugin '${n}' refused: it depends on plugin '${dep}', which the project does not have (${_root_name}/${dep}/plugin.cwplugin)")
            set(_changed ON)
          elseif(NOT _st_${dep} STREQUAL LOADED)
            string(TOLOWER "${_st_${dep}}" _s)
            set(_st_${n} REFUSED)
            set(_err_${n} "plugin '${n}' refused: it depends on plugin '${dep}', which is ${_s}")
            set(_changed ON)
          endif()
        endforeach()
      endif()
    endforeach()
  endwhile()
  # order: dependencies first
  set(_order "")
  set(_left ${_names})
  while(_left)
    set(_progress OFF)
    foreach(n ${_left})
      set(_ready ON)
      string(REPLACE "," ";" _deps "${_m_${n}_depends}")
      foreach(dep ${_deps})
        string(STRIP "${dep}" dep)
        if(NOT dep STREQUAL "" AND dep IN_LIST _left)
          set(_ready OFF)
        endif()
      endforeach()
      if(_ready)
        list(APPEND _order ${n})
        list(REMOVE_ITEM _left ${n})
        set(_progress ON)
      endif()
    endforeach()
    if(NOT _progress) # a cycle: keep directory order, mark them
      foreach(n ${_left})
        set(_st_${n} REFUSED)
        set(_err_${n} "plugin '${n}' refused: its dependencies form a cycle")
      endforeach()
      list(APPEND _order ${_left})
      set(_left "")
    endif()
  endwhile()
  # targets + table
  set(_externs "")
  set(_rows "")
  foreach(n ${_order})
    set(pdir ${_dir_${n}})
    set(_desc "0")
    if(_st_${n} STREQUAL LOADED AND _rt_${n})
      cw__plugin_sources(${pdir} "${_m_${n}_runtime_sources}" _rs)
      if(NOT _rs)
        set(_st_${n} FAILED)
        set(_err_${n} "plugin '${n}': no runtime sources (runtime_sources = ${_m_${n}_runtime_sources})")
      else()
        if(NOT TARGET cwplugin_${n})
          add_library(cwplugin_${n} STATIC ${_rs})
          target_link_libraries(cwplugin_${n} PUBLIC cartwheel)
          target_include_directories(cwplugin_${n} PRIVATE ${pdir})
        endif()
        target_link_libraries(${app} PRIVATE cwplugin_${n})
        string(APPEND _externs "extern const cw_plugin cw_plugin_${n};\n")
        set(_desc "&cw_plugin_${n}")
      endif()
    endif()
    # natively: the shared libraries the editor loads (every compatible plugin, enabled or not:
    # enabling one in the editor must not need a reconfigure)
    if(NOT CW_CART AND (_st_${n} STREQUAL LOADED OR _st_${n} STREQUAL DISABLED) AND NOT TARGET cwplugin_${n}_runtime_so
       AND NOT TARGET cwplugin_${n}_editor_so)
      set(_out ${CMAKE_BINARY_DIR}/plugins/${n})
      if(_rt_${n})
        cw__plugin_sources(${pdir} "${_m_${n}_runtime_sources}" _rs)
        if(_rs)
          add_library(cwplugin_${n}_runtime_so MODULE EXCLUDE_FROM_ALL ${_rs})
          set_target_properties(cwplugin_${n}_runtime_so PROPERTIES PREFIX "" OUTPUT_NAME ${n}_runtime
            LIBRARY_OUTPUT_DIRECTORY ${_out})
          target_include_directories(cwplugin_${n}_runtime_so PRIVATE ${pdir} ${CW_HOT_INCLUDES})
          target_compile_definitions(cwplugin_${n}_runtime_so PRIVATE CW_PLUGIN_SHARED=1)
          add_dependencies(cwplugins_all cwplugin_${n}_runtime_so)
        endif()
      endif()
      if(_ed_${n})
        cw__plugin_sources(${pdir} "${_m_${n}_editor_sources}" _es)
        if(_es)
          add_library(cwplugin_${n}_editor_so MODULE EXCLUDE_FROM_ALL ${_es})
          set_target_properties(cwplugin_${n}_editor_so PROPERTIES PREFIX "" OUTPUT_NAME ${n}_editor
            LIBRARY_OUTPUT_DIRECTORY ${_out})
          target_include_directories(cwplugin_${n}_editor_so PRIVATE ${pdir} ${CW_HOT_INCLUDES}
            ${CMAKE_SOURCE_DIR}/editor/include ${CMAKE_SOURCE_DIR}/editor/modules)
          target_compile_definitions(cwplugin_${n}_editor_so PRIVATE CW_PLUGIN_SHARED=1)
          add_dependencies(cwplugins_all cwplugin_${n}_editor_so)
        endif()
      endif()
    endif()
    set_property(GLOBAL PROPERTY CW_PLUGIN_EDITOR_OK_${app}_${n} OFF)
    if(_st_${n} STREQUAL LOADED AND _ed_${n})
      set_property(GLOBAL PROPERTY CW_PLUGIN_EDITOR_OK_${app}_${n} ON)
    endif()
    if(NOT _st_${n} STREQUAL LOADED)
      if(_st_${n} STREQUAL DISABLED OR quiet)
        message(STATUS "cartwheel: ${app}: plugin ${n}: ${_err_${n}}")
      else()
        message(WARNING "cartwheel: ${app}: ${_err_${n}}")
      endif()
    endif()
    string(REPLACE "\"" "'" _e "${_err_${n}}")
    string(APPEND _rows "  { \"${n}\", \"${_m_${n}_version}\", \"${_m_${n}_engine_api}\", \"${_m_${n}_provides}\", ${_desc}, CW_PLUGIN_${_st_${n}}, \"${_e}\" },\n")
  endforeach()
  set(_gen ${CMAKE_CURRENT_BINARY_DIR}/${app}_plugins.c)
  set(_content "/* GENERATED by cw_add_app (cmake/plugins.cmake) from ${pdir_root}: do not edit. */\n#include \"cartwheel/plugin.h\"\n${_externs}static const cw_plugin_build_entry table[] = {\n${_rows}  { 0 }\n};\nconst cw_plugin_build_entry *cw__plugin_table(void);\nconst cw_plugin_build_entry *cw__plugin_table(void) { return table; }\n")
  if(EXISTS ${_gen})
    file(READ ${_gen} _old)
  else()
    set(_old "")
  endif()
  if(NOT _old STREQUAL _content)
    file(WRITE ${_gen} "${_content}")
  endif()
  target_sources(${app} PRIVATE ${_gen})
  # every manifest is a configure input (editing enabled / engine_api reconfigures)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_manifests})
  set(CW_APP_PLUGIN_NAMES "${_order}" PARENT_SCOPE)
  if(want_editor AND _names)
    cw__request_project_editor(${app} ${pdir_root} ${CMAKE_CURRENT_SOURCE_DIR})
  endif()
endfunction()

# ── project editors: the editor with a project's plugins compiled in ─────
# For an app with plugins, cw__app_plugins records a request; at the end of
# the top-level CMakeLists.txt (the editor library exists by then)
# cw__make_project_editors defines <app>_editor: the editor app with the
# project's enabled editor plugins compiled in (cwed__static_plugins), its
# enabled runtime plugins (the engine table), and the project's files as its
# bundled project. This is how a CART editor gets plugins: a cart cannot load
# code at runtime (no dlopen; no ABI for it), so new plugin code means a
# rebuilt editor cart. Natively the ordinary editor loads plugins itself.
function(cw__request_project_editor app pdir_root project_dir)
  set_property(GLOBAL APPEND PROPERTY CW_PROJECT_EDITORS "${app}|${pdir_root}|${project_dir}")
endfunction()

function(cw__make_project_editors)
  get_property(_reqs GLOBAL PROPERTY CW_PROJECT_EDITORS)
  if(NOT TARGET cartwheel_editor OR NOT _reqs)
    return()
  endif()
  get_property(_cwed_assets GLOBAL PROPERTY CWED_ASSETS_DIR)
  foreach(req ${_reqs})
    string(REPLACE "|" ";" req "${req}")
    list(GET req 0 app)
    list(GET req 1 pdir_root)
    list(GET req 2 proj)
    set(ed ${app}_editor)
    if(TARGET ${ed})
      continue()
    endif()
    # the project's files as the editor's bundled project (symlinks: edits show without a reconfigure)
    set(stage ${CMAKE_BINARY_DIR}/project_editors/${ed})
    file(REMOVE_RECURSE ${stage})
    file(MAKE_DIRECTORY ${stage})
    file(GLOB _top RELATIVE ${proj} ${proj}/*)
    foreach(f ${_top})
      if(NOT f MATCHES "^\\." AND NOT f STREQUAL "exports" AND NOT f STREQUAL "build")
        file(CREATE_LINK ${proj}/${f} ${stage}/${f} SYMBOLIC)
      endif()
    endforeach()
    if(_cwed_assets)
      file(CREATE_LINK ${CMAKE_SOURCE_DIR}/editor/templates ${stage}/cwtemplates SYMBOLIC)
      if(EXISTS ${_cwed_assets}/cwtemplates.txt)
        file(CREATE_LINK ${_cwed_assets}/cwtemplates.txt ${stage}/cwtemplates.txt SYMBOLIC)
      endif()
    endif()
    # enabled, accepted editor plugins (the runtime side is cw_add_app's own table)
    file(GLOB _manifests ${pdir_root}/*/plugin.cwplugin)
    list(SORT _manifests)
    set(_srcs "")
    set(_externs "")
    set(_rows "")
    foreach(m ${_manifests})
      get_filename_component(_d ${m} DIRECTORY)
      get_filename_component(n ${_d} NAME)
      get_property(_ok GLOBAL PROPERTY CW_PLUGIN_EDITOR_OK_${app}_${n})
      if(NOT _ok)
        continue()
      endif()
      cw__manifest_get(${m} editor_sources _es)
      if(_es STREQUAL "")
        set(_es editor)
      endif()
      cw__plugin_sources(${_d} "${_es}" _files)
      if(_files)
        list(APPEND _srcs ${_files})
        string(APPEND _externs "extern const uint32_t cwed_plugin_api_${n};\nextern const cwed_module cwed_module_${n};\n")
        string(APPEND _rows "  { \"${n}\", &cwed_plugin_api_${n}, &cwed_module_${n} },\n")
      endif()
    endforeach()
    set(_gen ${CMAKE_BINARY_DIR}/project_editors/${ed}_static_plugins.c)
    set(_content "/* GENERATED by cmake/plugins.cmake: the editor plugins compiled into ${ed}. */\n#include \"cwed/editor.h\"\n${_externs}typedef struct { const char *name; const uint32_t *api; const cwed_module *module; } cwed_static_plugin;\nstatic const cwed_static_plugin table[] = {\n${_rows}  { 0 }\n};\nconst cwed_static_plugin *cwed__static_plugins(void);\nconst cwed_static_plugin *cwed__static_plugins(void) { return table; }\n")
    if(EXISTS ${_gen})
      file(READ ${_gen} _old)
    else()
      set(_old "")
    endif()
    if(NOT _old STREQUAL _content)
      file(WRITE ${_gen} "${_content}")
    endif()
    get_target_property(_progs ${app} CW_PROGRAMS) # the project's program tables draw its scenes
    if(NOT _progs)
      set(_progs "")
    endif()
    cw_add_app(${ed} SOURCES ${CMAKE_SOURCE_DIR}/editor/app/main.c ${_gen} ${_srcs} ASSETS ${stage} PLUGINS ${pdir_root} QUIET_PLUGINS
      NO_PROJECT_EDITOR PROGRAMS ${_progs} GL_ONLY) # the editor frame draws with GL
    target_link_libraries(${ed} PRIVATE cartwheel_editor)
    if(CW_ENGINE_ONLY) # a project build makes it only when asked (cwproject.mjs build <dir> editor)
      set_target_properties(${ed} PROPERTIES EXCLUDE_FROM_ALL ON)
    endif()
    target_include_directories(${ed} PRIVATE ${CMAKE_SOURCE_DIR}/editor/include ${CMAKE_SOURCE_DIR}/editor/modules)
    if(NOT CW_CART)
      target_compile_definitions(${ed} PRIVATE CWED_ENGINE_DIR="${CMAKE_SOURCE_DIR}")
    endif()
  endforeach()
endfunction()
