# Program tables carry what they were generated from (cmake/programs.cmake includes this; tools/programs.mjs stamps,
# tools/lib/program-sources.mjs hashes). In script mode it checks one table:
#   cmake -DCW_ROOT=<engine or SDK> -DMANIFEST=<manifest.txt> -P cmake/program-stamp.cmake

if(CMAKE_SCRIPT_MODE_FILE)
  set(CW_PROGRAM_TABLE_CHECK ON)
else()
  option(CW_PROGRAM_TABLE_CHECK "fail the configure when a program table was generated from other extension sources than the build has" ON)
endif()
# a configure re-runs when the file changes (nothing in script mode: tests/program-stamp.mjs)
function(cw__configure_depends file)
  if(NOT CMAKE_SCRIPT_MODE_FILE)
    set_property(DIRECTORY ${CMAKE_SOURCE_DIR} APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${file})
  endif()
endfunction()

# the hash tools/lib/program-sources.mjs gives a directory of extension modules: SHA-256 over each .mjs file in name
# order, as its name, a newline, its text with CRLF taken to LF, and a newline
function(cw__extension_dir_hash dir out)
  file(GLOB _files RELATIVE ${dir} ${dir}/*.mjs)
  list(SORT _files)
  set(_all "")
  foreach(f ${_files})
    file(READ ${dir}/${f} _t)
    string(REPLACE "\r\n" "\n" _t "${_t}")
    string(APPEND _all "${f}\n${_t}\n")
    cw__configure_depends(${dir}/${f})
  endforeach()
  string(SHA256 _h "${_all}")
  set(${out} ${_h} PARENT_SCOPE)
endfunction()

# A table's generated C carries the extension sources it was made from (tools/programs.mjs stamps it): a table made
# before an extension changed draws with the old programs (a value the new code sets is dropped). Each out-of-date or
# unstamped table is recorded; at the end of the configure cw__report_stale_tables names every one and stops, with one
# command that regenerates them all. The engine tree's own files are compared, or an SDK's cmake/program-sources.txt
# (tools/sdk-pack.mjs).
function(cw__check_table_stamp manifest tdir tname)
  if(NOT CW_PROGRAM_TABLE_CHECK OR NOT EXISTS ${tdir}/${tname}_gl.c)
    return()
  endif()
  cw__configure_depends(${tdir}/${tname}_gl.c)
  file(STRINGS ${tdir}/${tname}_gl.c _stamp LIMIT_INPUT 16384 REGEX "^/\\* cw-source")
  set(_why "")
  if(NOT _stamp)
    set(_why "not stamped (generated by an engine before the check)")
  endif()
  set(_sdk_list "")
  if(EXISTS ${CW_ROOT}/cmake/program-sources.txt)
    file(STRINGS ${CW_ROOT}/cmake/program-sources.txt _sdk_list)
    cw__configure_depends(${CW_ROOT}/cmake/program-sources.txt)
  endif()
  foreach(line ${_stamp})
    if(NOT line MATCHES "^/\\* cw-source (engine|table) ([^ ]+) ([0-9a-f]+) \\*/$")
      continue()
    endif()
    set(_kind ${CMAKE_MATCH_1})
    set(_rel ${CMAKE_MATCH_2})
    set(_want ${CMAKE_MATCH_3})
    set(_have "")
    if(_kind STREQUAL "table")
      if(EXISTS ${tdir}/${_rel})
        cw__extension_dir_hash(${tdir}/${_rel} _have)
      endif()
    elseif(IS_DIRECTORY ${CW_ROOT}/${_rel})
      cw__extension_dir_hash(${CW_ROOT}/${_rel} _have)
    else()
      foreach(s ${_sdk_list})
        if(s MATCHES "^${_rel} ([0-9a-f]+)$")
          set(_have ${CMAKE_MATCH_1})
        endif()
      endforeach()
    endif()
    if(NOT _have STREQUAL _want AND NOT _why)
      set(_why "generated from other sources than ${_rel} has now (a shader its states use changed)")
    endif()
  endforeach()
  if(NOT _why)
    return()
  endif()
  set_property(GLOBAL APPEND PROPERTY CW_STALE_TABLES "${manifest}")
  set_property(GLOBAL APPEND PROPERTY CW_STALE_TABLE_WHY "  ${tname} (${manifest}): ${_why}")
  if(CMAKE_SCRIPT_MODE_FILE)
    cw__report_stale_tables()
  else()
    get_property(_deferred GLOBAL PROPERTY CW_STALE_TABLES_DEFERRED)
    if(NOT _deferred)
      set_property(GLOBAL PROPERTY CW_STALE_TABLES_DEFERRED ON)
      cmake_language(DEFER DIRECTORY ${CMAKE_SOURCE_DIR} CALL cw__report_stale_tables)
    endif()
  endif()
endfunction()

# every out-of-date table at once, and the one command that regenerates them (tools/programs.mjs takes several --table
# and regenerates them in parallel)
function(cw__report_stale_tables)
  get_property(_tables GLOBAL PROPERTY CW_STALE_TABLES)
  get_property(_why GLOBAL PROPERTY CW_STALE_TABLE_WHY)
  if(NOT _tables)
    return()
  endif()
  list(LENGTH _tables _n)
  string(REPLACE ";" "\n" _list "${_why}")
  set(_tool "${CW_ROOT}/tools/programs.mjs")
  if(NOT EXISTS ${_tool})
    set(_tool "<the engine source: deps/cartwheel-engine>/tools/programs.mjs")
  endif()
  set(_cmd "node ${_tool}")
  foreach(m ${_tables})
    string(APPEND _cmd " --table ${m}")
  endforeach()
  message(FATAL_ERROR "${_n} program table(s) are out of date with the extensions they draw with, so their programs would "
    "draw without what changed:\n${_list}\nRegenerate them all (Node only, no GPU; about ten minutes a table, several "
    "at once), then commit the regenerated C:\n  ${_cmd}\n(-DCW_PROGRAM_TABLE_CHECK=OFF skips this check: for an "
    "emergency build only, never as the fix.)")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE AND MANIFEST)
  get_filename_component(_tdir ${MANIFEST} DIRECTORY)
  get_filename_component(_tname ${MANIFEST} NAME_WE)
  cw__check_table_stamp(${MANIFEST} ${_tdir} ${_tname})
  message(STATUS "program table ${_tname}: stamp matches")
endif()
