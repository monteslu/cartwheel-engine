[scene format=1]
[ext_scene id=1 path="scenes/hero_model.cwscene"]

[node name="Player" type="Hero" groups="player"]
collision_layer_name = "player"
collision_mask_names = "world|props|pickups|hazards|triggers"
push_mass = 60
step_height = 0.25
floor_snap_length = 0.3

[node name="Shape" parent="." type="CollisionShape3D"]
shape = CAPSULE
radius = 0.32
height = 1.5
position = vec3(0, 0.75, 0)

[node name="Model" parent="." instance=1]

[node name="Anim" parent="Model"]
autoplay = ""

[node name="Tree" parent="." type="AnimationTree"]
player = "../Model/Anim"

[animtree tree="Tree"]
clip name="idle" anim="idle"
clip name="run" anim="run"
blend1d name="ground" param="speed"
point of="ground" node="idle" x=0
point of="ground" node="run" x=6.5
clip name="jump" anim="jump"
clip name="fall" anim="fall"
clip name="dash" anim="dash"
clip name="cheer" anim="cheer"
machine name="body"
state of="body" name="ground" node="ground"
state of="body" name="jump" node="jump"
state of="body" name="fall" node="fall"
state of="body" name="dash" node="dash"
state of="body" name="cheer" node="cheer"
transition of="body" from="ground" to="cheer" xfade=0.15 if="cheering"
transition of="body" from="jump" to="cheer" xfade=0.15 if="cheering"
transition of="body" from="fall" to="cheer" xfade=0.15 if="cheering"
transition of="body" from="ground" to="dash" xfade=0.04 if="dashing"
transition of="body" from="jump" to="dash" xfade=0.04 if="dashing"
transition of="body" from="fall" to="dash" xfade=0.04 if="dashing"
transition of="body" from="ground" to="jump" xfade=0.06 if="jumping"
transition of="body" from="ground" to="fall" xfade=0.12 if="falling"
transition of="body" from="jump" to="ground" xfade=0.08 if="floor"
transition of="body" from="jump" to="fall" xfade=0.18 if="falling"
transition of="body" from="fall" to="ground" xfade=0.08 if="floor"
transition of="body" from="fall" to="jump" xfade=0.06 if="jumping"
transition of="body" from="dash" to="fall" xfade=0.1 if="!dashing"
transition of="body" from="cheer" to="ground" xfade=0.2 if="!cheering"
root node="body"
