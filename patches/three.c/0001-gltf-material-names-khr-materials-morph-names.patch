+static void *keep_owned(loader *L, void *p) {
+  if (L->owned_n == L->owned_cap) {
+    L->owned_cap = L->owned_cap ? L->owned_cap * 2 : 16;
+    L->owned = realloc(L->owned, (size_t)L->owned_cap * sizeof *L->owned);
