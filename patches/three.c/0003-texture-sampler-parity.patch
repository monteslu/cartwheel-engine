+/* flip_y draws are rendered upside down (clip y negated), so the screen's y
+ * runs the other way: r186's fragment programs take the y derivative of the
+ * WebGPU framebuffer (y down; they negate dpdy where GL's dFdy points up),
+ * which is the GL direction here. Every dpdy / dpdyFine / dpdyCoarse call
+ * is negated, (-dpdy( ... )), so a normal map's tangent frame (built from
+ * screen derivatives when the geometry has no tangents) and anything else
+ * read along screen y matches the unflipped picture and GLES. */
+static char *negate_dpdy(const char *src) {
+  size_t n = strlen(src), cap = n * 2 + 64, o = 0;
+  char *out = malloc(cap);
+  T3_CHECK_ALLOC(out);
+  /* close[i]: a ')' to emit after source byte i (nesting counted) */
+  int *closes = calloc(n + 1, sizeof *closes);
+  T3_CHECK_ALLOC(closes);
+  for (size_t i = 0; i < n; i++) {
+    bool start = !strncmp(src + i, "dpdy", 4) && (i == 0 || !(isalnum((unsigned char)src[i - 1]) || src[i - 1] == '_'));
+    if (start) {
+      size_t e = i + 4;
+      if (!strncmp(src + e, "Fine", 4) || !strncmp(src + e, "Coarse", 6)) e += src[e] == 'F' ? 4 : 6;
+      while (src[e] == ' ') e++;
+      if (src[e] == '(') {
+        int depth = 0;
+        size_t c = e;
+        for (; c < n; c++) {
+          if (src[c] == '(') depth++;
+          else if (src[c] == ')' && --depth == 0) break;
+        }
+        if (c < n) { out[o++] = '('; out[o++] = '-'; closes[c]++; }
+      }
+    }
+    out[o++] = src[i];
+    for (int k = 0; k < closes[i]; k++) out[o++] = ')';
+    if (o + 8 > cap) { cap *= 2; out = realloc(out, cap); T3_CHECK_ALLOC(out); }
+  }
+  out[o] = 0;
+  free(closes);
+  return out;
+}
+static WGPUShaderModule flip_fragment(t3_wgpu *w, struct gen_wgpu_prog *wg) {
+  if (!strstr(wg->ftext, "dpdy")) return wg->fs;   /* nothing reads screen y */
+  if (!wg->fs_flip) {
+    char *t = negate_dpdy(wg->ftext);
+    wg->fs_flip = module(w, t);
+    free(t);
+  }
+  return wg->fs_flip;
+}
