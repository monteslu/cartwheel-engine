# dtTileCache::update rebuilds one touched tile per call, on the calling thread. Split it
# into processObstacleRequests (the pending tiles, ascending), a const buildNavMeshTileData
# that any thread may run with its own allocator, and commitNavMeshTile, which swaps the
# tile in and finishes the obstacle bookkeeping. Committing in the listed order gives the
# same navmesh, refs and salts whether the builds ran on one thread or many. update() and
# buildNavMeshTile() keep their behaviour, built on the same three parts.
diff --git a/DetourTileCache/Include/DetourTileCache.h b/DetourTileCache/Include/DetourTileCache.h
index 0d346f1..8338f6f 100644
--- a/DetourTileCache/Include/DetourTileCache.h
+++ b/DetourTileCache/Include/DetourTileCache.h
@@ -158,6 +158,26 @@ public:
 	dtStatus buildNavMeshTilesAt(const int tx, const int ty, class dtNavMesh* navmesh);
 	
 	dtStatus buildNavMeshTile(const dtCompressedTileRef ref, class dtNavMesh* navmesh);
+
+	/// update() split in three, so touched tiles can rebuild on several threads with
+	/// the same result as one:
+	///  1. processObstacleRequests (one thread): turns queued obstacle requests into
+	///     the pending tile list, returned in ascending ref order;
+	///  2. buildNavMeshTileData (any thread, any order): a pure build of one tile; it
+	///     reads the cache and changes nothing. The allocator is the caller's (one per
+	///     thread), and the compressor and mesh process must be safe to call from
+	///     several threads at once;
+	///  3. commitNavMeshTile (one thread, in the order step 1 returned): swaps the
+	///     built tile into the navmesh and finishes the obstacles' bookkeeping.
+	///  @param[out]	tiles		The pending tiles, ascending. [(dtCompressedTileRef) * @p maxTiles]
+	///  @param[out]	ntiles		The number of pending tiles (all of them, even past @p maxTiles).
+	dtStatus processObstacleRequests(dtCompressedTileRef* tiles, int* ntiles, const int maxTiles);
+	///  @param[out]	navData		The tile's navmesh data (dtAlloc'd), or 0 when it has no polygons.
+	dtStatus buildNavMeshTileData(const dtCompressedTileRef ref, struct dtTileCacheAlloc* talloc,
+								  unsigned char** navData, int* navDataSize) const;
+	///  Takes ownership of @p navData (0: the tile's location is left empty).
+	dtStatus commitNavMeshTile(const dtCompressedTileRef ref, unsigned char* navData, const int navDataSize,
+							   class dtNavMesh* navmesh);
 	
 	void calcTightTileBounds(const struct dtTileCacheLayerHeader* header, float* bmin, float* bmax) const;
 	
@@ -206,6 +226,8 @@ public:
 	
 	
 private:
+	void processRequests();
+	void finishTile(const dtCompressedTileRef ref);
 	// Explicitly disabled copy constructor and copy assignment operator.
 	dtTileCache(const dtTileCache&);
 	dtTileCache& operator=(const dtTileCache&);
