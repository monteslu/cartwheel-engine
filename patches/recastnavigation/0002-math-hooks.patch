# libm transcendentals round differently per C library: the walkable-slope threshold
# (Recast.cpp) and the oriented-box obstacle rotation (DetourTileCache.cpp) go through
# rcMathCosf / dtMathCosf / dtMathSinf, which an embedder may supply (RC_MATH_HEADER,
# DT_MATH_HEADER) with deterministic implementations.
diff --git a/Detour/Include/DetourMath.h b/Detour/Include/DetourMath.h
index eec89ce..d40987f 100644
--- a/Detour/Include/DetourMath.h
+++ b/Detour/Include/DetourMath.h
@@ -13,9 +13,16 @@ inline float dtMathFabsf(float x) { return fabsf(x); }
 inline float dtMathSqrtf(float x) { return sqrtf(x); }
 inline float dtMathFloorf(float x) { return floorf(x); }
 inline float dtMathCeilf(float x) { return ceilf(x); }
+// DT_MATH_HEADER names a header that defines dtMathCosf, dtMathSinf and
+// dtMathAtan2f: libm's transcendentals round differently per C library, so an
+// embedder that needs the same results on every host supplies its own.
+#ifdef DT_MATH_HEADER
+#include DT_MATH_HEADER
+#else
 inline float dtMathCosf(float x) { return cosf(x); }
 inline float dtMathSinf(float x) { return sinf(x); }
 inline float dtMathAtan2f(float y, float x) { return atan2f(y, x); }
+#endif
