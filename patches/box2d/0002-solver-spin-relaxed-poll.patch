# Solver spin waits poll with relaxed loads and take the value they waited
# for with one full (acquire) load once it changes. Same code on x86 and
# the same ordering guarantees; the point is ThreadSanitizer. TSan serves
# every acquire load of a published atomic under a reader lock on its sync
# state and performs a release store under the writer lock, and that lock
# lets new readers in while a writer waits. With 20+ solver workers polling
# the stage sync bits with acquire loads, the orchestrator's store could
# starve forever: a TSan build hung about 1 run in 100 under load, every
# hang with the orchestrator parked in __tsan_atomic32_store.

diff --git a/src/platform.h b/src/platform.h
--- a/src/platform.h
+++ b/src/platform.h
@@ -141,6 +141,34 @@
 #endif
 }
 
+// Relaxed loads for spin-wait polling. A spinner polls with these and then
+// takes the value with a full (acquire) load once it has changed. On x86 the
+// code is the same, but ThreadSanitizer serves every acquire load of a
+// published atomic under a reader lock on its sync state, and a writer needs
+// that lock to store: many threads polling with acquire loads can starve the
+// one thread whose store would end the wait, forever.
+static inline int b2AtomicLoadRelaxedInt( b2AtomicInt* a )
+{
+#if defined( _MSC_VER )
+	return __iso_volatile_load32( (const volatile __int32*)&a->value );
+#elif defined( __GNUC__ ) || defined( __clang__ )
+	return __atomic_load_n( &a->value, __ATOMIC_RELAXED );
+#else
+#error "Unsupported platform"
+#endif
+}
+
+static inline uint32_t b2AtomicLoadRelaxedU32( b2AtomicU32* a )
+{
+#if defined( _MSC_VER )
+	return (uint32_t)__iso_volatile_load32( (const volatile __int32*)&a->value );
+#elif defined( __GNUC__ ) || defined( __clang__ )
+	return __atomic_load_n( &a->value, __ATOMIC_RELAXED );
+#else
+#error "Unsupported platform"
+#endif
+}
+
 static inline uint32_t b2AtomicLoadU32( b2AtomicU32* a )
 {
 #if defined( _MSC_VER ) && !defined( __clang__ )
