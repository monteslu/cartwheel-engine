# b2World_RestoreFromSnapshot zeroes the chain shape, sensor and island arrays it
# just resized; for an image with none of them the array is still NULL, and
# memset(NULL, 0, 0) is undefined behaviour (UBSan: null pointer passed as
# argument 1, declared nonnull). Each memset runs only for a count above zero.

diff --git a/src/snapshot.c b/src/snapshot.c
index 1c2da08..192d57c 100644
--- a/src/snapshot.c
+++ b/src/snapshot.c
@@ -710,7 +710,10 @@ static bool b2DeserializeIntoShell( b2SnapReader* r, b2World* world )
 		{
 			b2Array_Resize( world->chainShapes, chainCount );
 			// Zero the whole array so free slots have NULL pointers
-			memset( world->chainShapes.data, 0, chainCount * sizeof( b2ChainShape ) );
+			if ( chainCount > 0 )
+			{
+				memset( world->chainShapes.data, 0, chainCount * sizeof( b2ChainShape ) );
+			}
 		}
 
 		for ( int i = 0; i < chainCount && r->ok; ++i )
@@ -760,7 +763,10 @@ static bool b2DeserializeIntoShell( b2SnapReader* r, b2World* world )
 		{
 			b2Array_Resize( world->sensors, sensorCount );
 			// Zero so inner array headers start clean
-			memset( world->sensors.data, 0, sensorCount * sizeof( b2Sensor ) );
+			if ( sensorCount > 0 )
+			{
+				memset( world->sensors.data, 0, sensorCount * sizeof( b2Sensor ) );
+			}
 		}
 
 		for ( int i = 0; i < sensorCount && r->ok; ++i )
@@ -793,7 +799,10 @@ static bool b2DeserializeIntoShell( b2SnapReader* r, b2World* world )
 		if ( r->ok )
 		{
 			b2Array_Resize( world->islands, islandCount );
-			memset( world->islands.data, 0, islandCount * sizeof( b2Island ) );
+			if ( islandCount > 0 )
+			{
+				memset( world->islands.data, 0, islandCount * sizeof( b2Island ) );
+			}
 		}
 
 		for ( int i = 0; i < islandCount && r->ok; ++i )
