# WebAssembly SIMD for the solver and the SIMD math, under any wasm toolchain.
# core.h only recognised wasm through __EMSCRIPTEN__ (and then took the SSE2
# path through Emscripten's SSE emulation headers), so wasi-sdk carts
# (wasm32-wasip1-threads -msimd128) got B2_SIMD_NONE: the scalar fallback.
# Now __wasm__ with __wasm_simd128__ selects B2_SIMD_WASM, a wasm_simd128.h
# implementation of the SSE2 functions. It is bit-identical to SSE2: the same
# operations in the same order, multiply-adds as a multiply then an add (no
# FMA), and min/max with SSE's operand semantics (_mm_min_ps(a, b) is
# a < b ? a : b, which is wasm_f32x4_pmin(b, a); wasm_f32x4_min differs on
# signed zeros and NaN). Native x86 (SSE2) and carts run the same solver.

diff --git a/src/core.h b/src/core.h
--- a/src/core.h
+++ b/src/core.h
@@ -41,7 +41,7 @@
 	#define B2_CPU_X86_X64
 #elif defined( __aarch64__ ) || defined( _M_ARM64 ) || defined( __arm__ ) || defined( _M_ARM )
 	#define B2_CPU_ARM
-#elif defined( __EMSCRIPTEN__ )
+#elif defined( __EMSCRIPTEN__ ) || defined( __wasm__ )
 	#define B2_CPU_WASM
 #else
 	#define B2_CPU_UNKNOWN
@@ -65,9 +65,11 @@
 			// and unverifiable performance.
 			#define B2_SIMD_NONE
 		#endif
-	#elif defined( B2_CPU_WASM )
-		#define B2_CPU_WASM
-		#define B2_SIMD_SSE2
+	#elif defined( B2_CPU_WASM ) && defined( __wasm_simd128__ )
+		// WebAssembly SIMD (wasm_simd128.h), any toolchain: Emscripten or wasi-sdk.
+		// Bit-identical to the SSE2 path: the same operations in the same order,
+		// pmin/pmax with SSE min/max operand semantics, and no fused multiply-add.
+		#define B2_SIMD_WASM
 	#else
 		#define B2_SIMD_NONE
 	#endif
