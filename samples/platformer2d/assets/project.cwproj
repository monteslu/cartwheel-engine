; platformer2d project settings (cartwheel/physics_nodes.h)
layer_names_2d = "world, player, coins, props"
gravity_2d = vec2(0, 900)
pixels_per_meter = 32

; export presets (tools/cwexport.mjs --project samples/platformer2d/assets --preset <name>)
name = "Platformer 2D"
app = "platformer2d"
export.linux.platform = "linux-x64"
export.linux-arm64.platform = "linux-arm64"
export.windows.platform = "windows-x64"
export.macos.platform = "macos"
export.ios.platform = "ios"
export.android.platform = "android-arm64"
export.web.platform = "web"
export.cart.platform = "wasc"
export.android.app_id = "org.cartwheel.platformer2d"
