# cartwheel project settings (cartwheel/project.h)
name = 3D Platformer
app = platformer_3d
main_scene = main.cwscene
sources = src
scenes = main.cwscene, gem.cwscene
input.move_left = key:a, key:left, pad:left, axis:lx-
input.move_right = key:d, key:right, pad:right, axis:lx+
input.move_forward = key:w, key:up, pad:up, axis:ly-
input.move_back = key:s, key:down, pad:down, axis:ly+
input.jump = key:space, pad:south
layer_names_3d = "world, player, gems"
gravity_3d = vec3(0, -14, 0)
substeps = 4
render.width = 960
render.height = 540
render.msaa = 4
render.vsync = true
export.native.platform = linux-x64
export.native.output = exports/native
export.cart.platform = wasc
export.cart.output = exports/cart
