# cartwheel project settings (cartwheel/project.h)
name = Empty 3D
app = empty_3d
main_scene = main.cwscene
sources = src
scenes = main.cwscene
input.ui_accept = key:return, key:space, pad:south
layer_names_3d = "world"
render.width = 960
render.height = 540
render.msaa = 4
render.vsync = true
export.native.platform = linux-x64
export.native.output = exports/native
export.cart.platform = wasc
export.cart.output = exports/cart
